diff --git a/app/src/main/java/com/example/cubechat/data/AndroidBindings.kt b/app/src/main/java/com/example/cubechat/data/AndroidBindings.kt
new file mode 100644
index 0000000..c5986a9
--- /dev/null
+++ b/app/src/main/java/com/example/cubechat/data/AndroidBindings.kt
@@ -0,0 +1,68 @@
+package com.example.cubechat.data
+
+import android.content.SharedPreferences
+import android.security.keystore.KeyGenParameterSpec
+import android.security.keystore.KeyProperties
+import java.security.KeyStore
+import java.util.Base64
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+
+class PrefsKeyValue(private val prefs: SharedPreferences) : KeyValue {
+    override fun get(key: String): String? = prefs.getString(key, null)
+
+    override fun put(key: String, value: String) {
+        prefs.edit().putString(key, value).apply()
+    }
+}
+
+/**
+ * Enkripsi AES-256-GCM dengan kunci yang disimpan di Android Keystore (tidak bisa dibaca keluar dari HP).
+ * Kalau kunci hilang (mis. setelah restore cadangan), password lama tidak bisa dibuka dan diperlakukan
+ * sebagai tidak ada: pemain cukup login manual lagi dan diminta menyimpan ulang.
+ */
+class KeystoreVault : Vault {
+    private val alias = "cubechat_vault_v1"
+
+    private fun key(): SecretKey {
+        val ks = KeyStore.getInstance("AndroidKeyStore")
+        ks.load(null)
+        val existing = ks.getKey(alias, null)
+        if (existing is SecretKey) return existing
+        val gen = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore")
+        gen.init(
+            KeyGenParameterSpec.Builder(alias, KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(256)
+                .build()
+        )
+        return gen.generateKey()
+    }
+
+    override fun encrypt(plain: String): String? {
+        return try {
+            val c = Cipher.getInstance("AES/GCM/NoPadding")
+            c.init(Cipher.ENCRYPT_MODE, key())
+            val iv = c.iv
+            val ct = c.doFinal(plain.toByteArray(Charsets.UTF_8))
+            Base64.getEncoder().encodeToString(iv + ct)
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    override fun decrypt(token: String): String? {
+        return try {
+            val all = Base64.getDecoder().decode(token)
+            if (all.size < 13) return null
+            val c = Cipher.getInstance("AES/GCM/NoPadding")
+            c.init(Cipher.DECRYPT_MODE, key(), GCMParameterSpec(128, all.copyOfRange(0, 12)))
+            String(c.doFinal(all.copyOfRange(12, all.size)), Charsets.UTF_8)
+        } catch (e: Exception) {
+            null
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/cubechat/data/AuthRules.kt b/app/src/main/java/com/example/cubechat/data/AuthRules.kt
new file mode 100644
index 0000000..48474cd
--- /dev/null
+++ b/app/src/main/java/com/example/cubechat/data/AuthRules.kt
@@ -0,0 +1,72 @@
+package com.example.cubechat.data
+
+/** Perintah login/daftar yang diketik pemain. */
+data class AuthCommand(val password: String, val register: Boolean)
+
+/**
+ * Aturan mengenali plugin login server (AuthMe, nLogin, LoginSecurity, dan sejenisnya).
+ * Murni teks, tanpa dependensi Android, supaya mudah diuji.
+ */
+object AuthRules {
+    private val LOGIN_CMDS = setOf("login", "log", "l")
+    private val REGISTER_CMDS = setOf("register", "reg")
+
+    // "/login", "/log", atau "/l" yang berdiri sendiri (bukan "/lobby", "/list", dst).
+    private val loginMention = Regex("""/(login|log|l)(?=[\s<\[(.,:'"!]|$)""", RegexOption.IGNORE_CASE)
+    private val registerMention = Regex("""/(register|reg)(?=[\s<\[(.,:'"!]|$)""", RegexOption.IGNORE_CASE)
+
+    private val loginWords = listOf(
+        "please login", "please log in", "please, login", "silakan login", "silahkan login",
+        "silakan masuk", "silahkan masuk", "you must login", "you need to login", "harap login"
+    )
+    private val failureWords = listOf(
+        "wrong password", "incorrect password", "invalid password", "password salah", "kata sandi salah",
+        "sandi salah", "login failed", "failed to login", "gagal login", "salah!", "wrong!", "incorrect!",
+        "tidak cocok", "doesn't match", "does not match", "not match"
+    )
+    private val successWords = listOf(
+        "successful login", "successfully logged", "logged in", "login successful", "berhasil login",
+        "berhasil masuk", "berhasil mendaftar", "successfully registered", "register successful",
+        "welcome back", "selamat datang kembali", "authenticated", "terautentikasi"
+    )
+
+    /** "/login rahasia" atau "/register rahasia rahasia" -> AuthCommand. Selain itu null. */
+    fun parseCommand(text: String): AuthCommand? {
+        val t = text.trim()
+        if (!t.startsWith("/")) return null
+        val parts = t.split(Regex("\\s+"))
+        if (parts.size < 2) return null
+        // Buang awalan namespace, mis. "/authme:login".
+        val cmd = parts[0].removePrefix("/").substringAfterLast(':').lowercase()
+        return when {
+            cmd in LOGIN_CMDS -> AuthCommand(parts[1], false)
+            cmd in REGISTER_CMDS -> AuthCommand(parts[1], true)
+            else -> null
+        }
+    }
+
+    /** Server meminta login (menyebut /login atau kalimat yang sejenis). */
+    fun isLoginPrompt(text: String): Boolean {
+        val t = text.lowercase()
+        if (isFailure(t)) return false
+        if (loginMention.containsMatchIn(t)) return true
+        // Server yang hanya menyebut /register tanpa /login sedang meminta daftar, bukan login.
+        if (registerMention.containsMatchIn(t)) return false
+        return loginWords.any { t.contains(it) }
+    }
+
+    fun isRegisterPrompt(text: String): Boolean {
+        val t = text.lowercase()
+        return registerMention.containsMatchIn(t) && !loginMention.containsMatchIn(t)
+    }
+
+    fun isFailure(text: String): Boolean {
+        val t = text.lowercase()
+        return failureWords.any { t.contains(it) }
+    }
+
+    fun isSuccess(text: String): Boolean {
+        val t = text.lowercase()
+        return successWords.any { t.contains(it) }
+    }
+}
diff --git a/app/src/main/java/com/example/cubechat/data/Store.kt b/app/src/main/java/com/example/cubechat/data/Store.kt
new file mode 100644
index 0000000..d773482
--- /dev/null
+++ b/app/src/main/java/com/example/cubechat/data/Store.kt
@@ -0,0 +1,149 @@
+package com.example.cubechat.data
+
+import java.net.URLDecoder
+import java.net.URLEncoder
+import java.util.UUID
+
+data class ServerEntry(val id: String, val name: String, val address: String, val defaultUser: String)
+
+/** Penyimpanan kunci-nilai sederhana (di Android: SharedPreferences). */
+interface KeyValue {
+    fun get(key: String): String?
+    fun put(key: String, value: String)
+}
+
+/** Enkripsi password (di Android: Keystore, AES-GCM). */
+interface Vault {
+    fun encrypt(plain: String): String?
+    fun decrypt(token: String): String?
+}
+
+/**
+ * Daftar server, daftar akun, dan password login otomatis.
+ * Password HANYA disimpan terenkripsi lewat [Vault]; teks aslinya tidak pernah ditulis ke penyimpanan.
+ */
+class Store(private val kv: KeyValue, private val vault: Vault) {
+    private companion object {
+        const val KEY_SERVERS = "servers_v1"
+        const val KEY_ACCOUNTS = "accounts_v1"
+        const val KEY_CREDS = "creds_v1"
+    }
+
+    private fun enc(s: String): String = URLEncoder.encode(s, "UTF-8")
+    private fun dec(s: String): String = URLDecoder.decode(s, "UTF-8")
+
+    private fun credKey(address: String, user: String) =
+        address.trim().lowercase() + "|" + user.trim().lowercase()
+
+    fun newId(): String = UUID.randomUUID().toString().take(8)
+
+    // ------------------------------------------------------------------ server
+
+    fun loadServers(): List<ServerEntry> {
+        val raw = kv.get(KEY_SERVERS) ?: return migrateOld()
+        return raw.split('\n').mapNotNull { line ->
+            val p = line.split('\t')
+            if (p.size < 4) null else ServerEntry(dec(p[0]), dec(p[1]), dec(p[2]), dec(p[3]))
+        }
+    }
+
+    fun saveServers(list: List<ServerEntry>) {
+        kv.put(KEY_SERVERS, list.joinToString("\n") { s ->
+            listOf(s.id, s.name, s.address, s.defaultUser).joinToString("\t") { enc(it) }
+        })
+    }
+
+    /** Versi lama menyimpan "recent" (alamat) dan "user". Jadikan daftar server pertama. */
+    private fun migrateOld(): List<ServerEntry> {
+        val user = kv.get("user")?.trim().orEmpty()
+        val recent = kv.get("recent").orEmpty().split('\n').map { it.trim() }.filter { it.isNotEmpty() }
+        val list = recent.map { ServerEntry(newId(), it, it, user) }
+        if (list.isNotEmpty()) saveServers(list)
+        return list
+    }
+
+    // ------------------------------------------------------------------- akun
+
+    fun loadAccounts(): List<String> {
+        val raw = kv.get(KEY_ACCOUNTS)
+        if (raw == null) {
+            val old = kv.get("user")?.trim().orEmpty()
+            if (old.isNotEmpty()) {
+                saveAccounts(listOf(old))
+                return listOf(old)
+            }
+            return emptyList()
+        }
+        return raw.split('\n').filter { it.isNotEmpty() }.map { dec(it) }
+    }
+
+    fun saveAccounts(list: List<String>) {
+        kv.put(KEY_ACCOUNTS, list.joinToString("\n") { enc(it) })
+    }
+
+    // --------------------------------------------------------------- password
+
+    private fun loadCreds(): MutableMap<String, String> {
+        val map = LinkedHashMap<String, String>()
+        val raw = kv.get(KEY_CREDS) ?: return map
+        for (line in raw.split('\n')) {
+            val p = line.split('\t')
+            if (p.size == 2) map[dec(p[0])] = p[1]
+        }
+        return map
+    }
+
+    private fun saveCreds(map: Map<String, String>) {
+        kv.put(KEY_CREDS, map.entries.joinToString("\n") { enc(it.key) + "\t" + it.value })
+    }
+
+    fun password(address: String, user: String): String? {
+        val token = loadCreds()[credKey(address, user)] ?: return null
+        return vault.decrypt(token)
+    }
+
+    fun hasPassword(address: String, user: String): Boolean =
+        loadCreds().containsKey(credKey(address, user))
+
+    /** Mengembalikan false kalau enkripsi gagal (password TIDAK disimpan). */
+    fun savePassword(address: String, user: String, password: String): Boolean {
+        val token = vault.encrypt(password) ?: return false
+        val map = loadCreds()
+        map[credKey(address, user)] = token
+        saveCreds(map)
+        return true
+    }
+
+    fun deletePassword(address: String, user: String) {
+        val map = loadCreds()
+        if (map.remove(credKey(address, user)) != null) saveCreds(map)
+    }
+
+    fun deleteForUser(user: String) {
+        val suffix = "|" + user.trim().lowercase()
+        val map = loadCreds()
+        if (map.keys.removeAll { it.endsWith(suffix) }) saveCreds(map)
+    }
+
+    fun deleteForServer(address: String) {
+        val prefix = address.trim().lowercase() + "|"
+        val map = loadCreds()
+        if (map.keys.removeAll { it.startsWith(prefix) }) saveCreds(map)
+    }
+
+    fun countForUser(user: String): Int {
+        val suffix = "|" + user.trim().lowercase()
+        return loadCreds().keys.count { it.endsWith(suffix) }
+    }
+
+    /** Alamat server berubah: pindahkan password yang sudah tersimpan. */
+    fun moveServerPasswords(oldAddress: String, newAddress: String) {
+        val o = oldAddress.trim().lowercase() + "|"
+        val n = newAddress.trim().lowercase() + "|"
+        if (o == n) return
+        val map = loadCreds()
+        val moved = LinkedHashMap<String, String>()
+        for ((k, v) in map) moved[if (k.startsWith(o)) n + k.removePrefix(o) else k] = v
+        saveCreds(moved)
+    }
+}
